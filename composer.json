{
    "name": "phinocio/oauth2-nexus-mods",
    "description": "Unofficial Nexus Mods provider for league/oauth2-client",
    "type": "library",
	"version": "1.0.0",
    "require": {
		"php": ">=8.2",
        "league/oauth2-client": "^2.9"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Phinocio\\Oauth2NexusMods\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Phinocio",
            "email": "github@phinocio.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
	"scripts": {
		"lint": "php-cs-fixer check",
		"lint:fix": "php-cs-fixer fix",
		"test:types": "phpstan"
	}
}
